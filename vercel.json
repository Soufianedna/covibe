{
  "outputDirectory": "dist",
  "buildCommand": "",
  "rewrites": [
    {
      "source": "/reset-password.html",
      "destination": "/reset-password.html"
    },
    {
      "source": "/verify.html",
      "destination": "/verify.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ]
}