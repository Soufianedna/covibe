{
  "appId": "ca.covibe.app",
  "appName": "CoVibe",
  "webDir": "dist",
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "launchAutoHide": true,
      "backgroundColor": "#1e1040",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "App": {
      "appUrlOpen": "covibe://"
    },
    "GoogleAuth": {
      "scopes": [
        "profile",
        "email"
      ],
      "serverClientId": "964731003706-ms57la8em2lb8dq6ambu6llc7h53g7sq.apps.googleusercontent.com",
      "forceCodeForRefreshToken": true
    }
  },
  "packageClassList": [
    "AppleAuthPlugin",
    "AppPlugin",
    "GeolocationPlugin",
    "SplashScreenPlugin"
  ],
  "ios": {
    "handleApplicationNotifications": false
  }
}